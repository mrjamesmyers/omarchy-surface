[Unit]
Description=Set screen brightness from the sun (no ambient light sensor needed)
Documentation=https://github.com/linux-surface/linux-surface/issues/2274
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/surface-autobrightness apply

[Install]
WantedBy=graphical-session.target
